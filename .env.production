# Production configuration (committed, non-secret).
# The server serves the built SPA and the API from one origin.
# Secrets belong in .env.production.local (gitignored).
RELAY_ENV=production
RELAY_PUBLIC_URL=http://127.0.0.1:7433
AUTH_PROVIDER=github
AUTH_ALLOW_LOCAL=false
RELAY_STATIC_DIR=packages/web/dist
