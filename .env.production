# Production configuration (committed, non-secret).
# The server serves the built SPA and the API from one origin.
# User-specific values (AUTH_ALLOWED_GITHUB, RELAY_WORKSPACE_ROOTS) and secrets
# belong in .env.production.local (gitignored). Binding a non-loopback
# RELAY_HOST requires both allowlists — the server refuses to start without them.
RELAY_ENV=production
RELAY_PUBLIC_URL=http://127.0.0.1:7433
RELAY_STATIC_DIR=packages/web/dist
