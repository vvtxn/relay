# Relay environment template.
#
# Committed, non-secret mode defaults live in .env.development / .env.production.
# Everything here belongs in the gitignored .local files. Precedence (highest to
# lowest): process env > .env.<mode>.local > .env.<mode> > .env.local > .env
#
# Select the mode with RELAY_ENV=development|production (default: development).

# --- Shared secrets (.env.local) ---
LLM_API_KEY=

# --- Per-environment secrets (.env.development.local / .env.production.local) ---
TURSO_DB_URL=
TURSO_DB_TOKEN=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Local auth mode (only when AUTH_PROVIDER=local) ---
DEV_AUTH_SUBJECT=

# --- CLI local bridge (requires AUTH_ALLOW_LOCAL=true; loopback only) ---
RELAY_AUTH_SUBJECT=

# --- User-specific (put in .env.<mode>.local; empty allowlists mean "any") ---
# Comma-separated GitHub logins or numeric ids allowed to sign in.
# Required when AUTH_PROVIDER=github binds a non-loopback RELAY_HOST.
# AUTH_ALLOWED_GITHUB=octocat,12345
# Comma-separated absolute roots a session workspace must sit within.
# Required when AUTH_PROVIDER=github binds a non-loopback RELAY_HOST.
# RELAY_WORKSPACE_ROOTS=/srv/projects,/srv/other
