# Relay environment template.
#
# Copy to `.env` (gitignored). Source commands load it from the working
# directory, current worktree, and main worktree; the single executable reads
# the working directory then ~/.relay. Process environment values always win.
#
# `pnpm relay` runs the cloud build: Turso + GitHub + the bundled web app on
# 127.0.0.1:7433. `pnpm relay:local` runs the self-hosted local build: SQLite +
# local auth and ignores the Turso/GitHub values below.
#
# The LLM API key is not an env var: it is entered once in the web app's
# Settings page and stored per user, encrypted at rest. By default it is kept
# in local files under RELAY_DATA_DIR; RELAY_SETTINGS_STORE=database stores it
# in the database instead.

# --- Cloud database (required by `pnpm relay`) ---
# URLs may use turso://, libsql://, or https://.
TURSO_DB_URL=
TURSO_DB_TOKEN=

# --- GitHub App (required by `pnpm relay`) ---
# Callback URL: http://127.0.0.1:7433/api/auth/callback
# Set the matching public URL below when deploying behind a real hostname.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Public deployment (optional) ---
# Public HTTPS origin of the server; must match the GitHub callback URL.
# Required (and must be https) for a non-loopback RELAY_HOST.
# RELAY_PUBLIC_URL=https://relay.example.com
# Bind address (default 127.0.0.1). Non-loopback also requires the two
# allowlists below.
# RELAY_HOST=0.0.0.0
# Comma-separated GitHub logins or numeric ids allowed to sign in.
# AUTH_ALLOWED_GITHUB=octocat,12345
# Absolute workspace roots. Cloud defaults to the server user's home; local
# allows any directory. Required for a non-loopback cloud host; `*` is rejected.
# RELAY_WORKSPACE_ROOTS=/srv/projects,/srv/other

# --- LLM provider (optional) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=350000
# LLM_PRESERVE_RECENT_TURNS=6
# LLM_MAX_COMPLETION_TOKENS=16384

# --- Server (optional) ---
# RELAY_PORT=7433
# Directory for local state: SQLite, settings files, logs, and the generated
# master key (default ~/.relay).
# RELAY_DATA_DIR=/var/lib/relay
# Local-mode database file (default RELAY_DATA_DIR/relay.db).
# RELAY_DB_PATH=~/.relay/relay.db
# Threads kept per workspace. Cloud defaults to 10; local defaults to
# unlimited (0). Older threads are pruned when a positive limit is set.
# RELAY_MAX_SESSIONS_PER_WORKSPACE=10
# Per-user settings backend: `file` (default) or `database`.
# RELAY_SETTINGS_STORE=file
# Master key encrypting per-user secrets at rest (32 bytes, base64url or hex).
# Required with RELAY_SETTINGS_STORE=database; otherwise generated in
# RELAY_DATA_DIR/secret.key.
# RELAY_SECRET_KEY=
# RELAY_SECRET_KEY_FILE=/run/secrets/relay-master-key
# AUTH_SESSION_TTL_DAYS=30
