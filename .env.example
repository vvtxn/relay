# Relay environment template.
#
# Committed, non-secret mode defaults live in .env.development / .env.production.
# Everything here belongs in the gitignored .local files. Precedence (highest to
# lowest): process env > .env.<mode>.local > .env.<mode> > .env.local > .env
#
# Select the mode with RELAY_ENV=development|production (default: development).
#
# The LLM API key is not an env var: it is entered once in the web app's
# Settings page and stored per user, encrypted at rest. By default it is kept
# in local files under RELAY_DATA_DIR and never reaches the database; set
# RELAY_SETTINGS_STORE=database to store it in the database instead.

# --- Per-environment secrets (.env.development.local / .env.production.local) ---
TURSO_DB_URL=
TURSO_DB_TOKEN=
# Required: the server is GitHub-OAuth-only and refuses to start without these.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Master key encrypting per-user secrets at rest (32 bytes, base64url or hex —
# `openssl rand -base64 32`). Required with RELAY_SETTINGS_STORE=database;
# optional with the file backend, which otherwise generates RELAY_DATA_DIR/secret.key.
# RELAY_SECRET_KEY=
# RELAY_SECRET_KEY_FILE=/run/secrets/relay-master-key

# --- User-specific (put in .env.<mode>.local; empty allowlists mean "any") ---
# Comma-separated GitHub logins or numeric ids allowed to sign in.
# Required when binding a non-loopback RELAY_HOST.
# AUTH_ALLOWED_GITHUB=octocat,12345
# Absolute roots a session workspace must sit within. Defaults to the server
# user's home directory; use `*` to allow any directory (not allowed for a
# non-loopback RELAY_HOST). Required when binding a non-loopback RELAY_HOST.
# RELAY_WORKSPACE_ROOTS=/srv/projects,/srv/other
# RELAY_WORKSPACE_ROOTS=*

# --- Server ---
# Port the server listens on (default 7433). In development the CLI starts a
# free fallback port when this is unset and the default is taken; production
# and explicit values fail to start instead of moving.
# RELAY_PORT=7433
# Where per-user settings (the LLM API key) live: `file` (default) keeps them
# on this host; `database` keeps them encrypted in the database and requires a
# master key. Switching to `file` migrates existing database keys and clears them.
# RELAY_SETTINGS_STORE=file
# Maximum threads kept per workspace (default 10). Starting another thread
# removes the least recently active one; startup trims existing overflow.
# RELAY_MAX_SESSIONS_PER_WORKSPACE=10
# Directory for local state: settings files and the generated master key
# (default ~/.relay).
# RELAY_DATA_DIR=/var/lib/relay
