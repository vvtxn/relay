# Development configuration (committed, non-secret).
# Vite serves the SPA and proxies /api to the Relay server.
# User-specific values (GitHub allowlist, workspace roots) and secrets belong
# in .env.development.local (gitignored).
RELAY_ENV=development
RELAY_PUBLIC_URL=http://localhost:5173
AUTH_PROVIDER=github
AUTH_ALLOW_LOCAL=true
