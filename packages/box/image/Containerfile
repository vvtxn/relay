# Prepared box image with the toolchain agents expect.
#
# Build and load it into the local Microsandbox image cache:
#   pnpm box:image
#
# The build script downloads the Playwright browser archives once and copies
# them into this build context, so the image build never depends on Playwright's
# own downloader. The image is selected automatically by RELAY_BOX_IMAGE=auto.
#
# The image intentionally runs as root inside the VM. Microsandbox maps guest
# root writes on host mounts back to the invoking user, so host-side file tools
# keep working.

ARG PLAYWRIGHT_VERSION=1.49.1
ARG CHROMIUM_REVISION=1148

FROM node:26-bookworm

ARG PLAYWRIGHT_VERSION
ARG CHROMIUM_REVISION

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    PLAYWRIGHT_SKIP_BROWSER_GC=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        git-lfs \
        openssh-client \
        jq \
        build-essential \
        python3 \
        python3-pip \
        sqlite3 \
        postgresql-client \
        redis-tools \
        tmux \
        procps \
        ripgrep \
        less \
        # Playwright/Chromium runtime dependencies.
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libegl1 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libxshmfence1 \
        xvfb \
        fonts-noto-color-emoji \
        fonts-unifont \
        libfontconfig \
        libfreetype6 \
        xfonts-scalable \
        fonts-ipafont-gothic \
        fonts-wqy-zenhei \
        fonts-tlwg-loma-otf \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "playwright@${PLAYWRIGHT_VERSION}" "pnpm@11.13.0"

COPY browsers/chromium-linux.zip /tmp/chromium-linux.zip
COPY browsers/chromium-headless-shell-linux.zip /tmp/chromium-headless-shell-linux.zip
RUN mkdir -p "/opt/playwright/chromium-${CHROMIUM_REVISION}" "/opt/playwright/chromium_headless_shell-${CHROMIUM_REVISION}" \
    && unzip -q /tmp/chromium-linux.zip -d "/opt/playwright/chromium-${CHROMIUM_REVISION}" \
    && unzip -q /tmp/chromium-headless-shell-linux.zip -d "/opt/playwright/chromium_headless_shell-${CHROMIUM_REVISION}" \
    && rm -f /tmp/chromium-linux.zip /tmp/chromium-headless-shell-linux.zip \
    && chmod 0755 "/opt/playwright/chromium-${CHROMIUM_REVISION}/chrome-linux/chrome" \
    && chmod 0755 "/opt/playwright/chromium_headless_shell-${CHROMIUM_REVISION}/chrome-linux/headless_shell"

# A tiny askpass helper lets git push use the placeholder GITHUB_TOKEN;
# Microsandbox substitutes the real value only for the configured git host.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'case "$1" in' \
        '  *Username*) printf "%s\\n" "x-access-token" ;;' \
        '  *Password*) printf "%s\\n" "${GITHUB_TOKEN:-}" ;;' \
        '  *) printf "\\n" ;;' \
        'esac' \
        > /usr/local/bin/relay-git-askpass \
    && chmod 0755 /usr/local/bin/relay-git-askpass

WORKDIR /workspace
RUN mkdir -p /relay-cache
CMD ["sleep", "infinity"]
