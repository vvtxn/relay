{
	"name": "relay",
	"private": true,
	"type": "module",
	"scripts": {
		"relay": "RELAY_FLAVOR=cloud node scripts/relay.ts",
		"relay:local": "RELAY_FLAVOR=local node scripts/relay.ts",
		"web:build": "vp -C packages/web build",
		"build": "vp -C packages/web build && vp -C packages/cli pack",
		"build:sea": "node scripts/build-sea.ts",
		"box:image": "node scripts/box-image.ts",
		"check": "vp check",
		"fmt": "vp fmt",
