		"lint": "vp lint",
		"version": "node scripts/version.ts",
		"version:bump": "node scripts/bump.ts"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"vite-plus": "^1.1.0"
	},
	"engines": {
		"node": ">=26.11.1"
	},
	"packageManager": "pnpm@11.13.0"
}
